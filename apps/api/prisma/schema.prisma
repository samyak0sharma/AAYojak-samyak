generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

enum EventType {
  FREE
  PAID
}

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  KHALTI
  ESEWA
  OTHER
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  MANUAL_REQUIRED
}

enum TicketStatus {
  ISSUED
  USED
  CANCELLED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum NotificationType {
  BOOKING_CONFIRMATION
  PAYMENT_CONFIRMATION
  TICKET_GENERATED
  EVENT_UPDATE
  CANCELLATION
  ORGANIZER_APPROVAL
  EVENT_MODERATION
  SYSTEM
}

enum ReportTargetType {
  EVENT
  ORGANIZER
  REVIEW
  USER
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CheckInResult {
  VALID
  ALREADY_USED
  CANCELLED
  EXPIRED
  INVALID
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String?
  firstName       String    @db.VarChar(80)
  lastName        String    @db.VarChar(80)
  avatarUrl       String?
  phone           String?   @db.VarChar(32)
  role            UserRole  @default(USER)
  googleId        String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organizer           Organizer?
  bookings            Booking[]
  reviews             Review[]
  notifications       Notification[]
  reports             Report[]                 @relation("ReportReporter")
  resolvedReports     Report[]                 @relation("ReportResolver")
  favorites           Favorite[]
  checkIns            CheckIn[]                @relation("CheckInChecker")
  moderatedEvents     Event[]                  @relation("EventModerator")
  sessions            AuthSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  refunds             Refund[]                 @relation("RefundRequester")

  @@index([role, isActive])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(128)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?   @db.VarChar(500)
  ipAddress        String?   @db.VarChar(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([consumedAt, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([consumedAt, expiresAt])
}

model Organizer {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  name         String   @db.VarChar(160)
  slug         String   @unique @db.VarChar(180)
  description  String?
  logoUrl      String?
  websiteUrl   String?
  contactEmail String?  @db.VarChar(320)
  contactPhone String?  @db.VarChar(32)
  location     String?  @db.VarChar(180)
  socialLinks  Json?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([isApproved, createdAt])
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  organizerId    String      @db.Uuid
  slug           String      @unique @db.VarChar(220)
  title          String      @db.VarChar(220)
  description    String
  coverImageUrl  String?
  eventType      EventType   @default(FREE)
  status         EventStatus @default(DRAFT)
  startAt        DateTime
  endAt          DateTime
  timezone       String      @default("Asia/Kathmandu") @db.VarChar(64)
  venueName      String      @db.VarChar(180)
  address        String
  capacity       Int?
  latitude       Float?
  longitude      Float?
  terms          String?
  publishedAt    DateTime?
  moderatedAt    DateTime?
  moderatedById  String?     @db.Uuid
  moderationNote String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organizer   Organizer       @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  moderatedBy User?           @relation("EventModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  categories  EventCategory[]
  media       EventMedia[]
  ticketTiers TicketTier[]
  bookings    Booking[]
  reviews     Review[]
  faqs        FAQ[]
  favorites   Favorite[]

  @@index([organizerId, status])
  @@index([status, startAt])
  @@index([eventType, status, startAt])
  @@index([venueName])
}

model EventMedia {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @db.Uuid
  mediaType MediaType @default(IMAGE)
  url       String
  publicId  String?
  altText   String?   @db.VarChar(180)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EventCategory[]

  @@index([isActive, name])
}

model EventCategory {
  eventId    String @db.Uuid
  categoryId String @db.Uuid

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([eventId, categoryId])
  @@index([categoryId, eventId])
}

model TicketTier {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String    @db.Uuid
  name             String    @db.VarChar(100)
  description      String?
  price            Decimal   @db.Decimal(12, 2)
  currency         String    @default("NPR") @db.VarChar(3)
  quantity         Int
  reservedQuantity Int       @default(0)
  soldQuantity     Int       @default(0)
  saleStartAt      DateTime?
  saleEndAt        DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
  @@index([saleStartAt, saleEndAt])
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  bookingNumber String        @unique @db.VarChar(40)
  userId        String        @db.Uuid
  eventId       String        @db.Uuid
  status        BookingStatus @default(PENDING)
  currency      String        @default("NPR") @db.VarChar(3)
  subtotal      Decimal       @db.Decimal(12, 2)
  fees          Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  expiresAt     DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items    BookingItem[]
  payments Payment[]
  tickets  Ticket[]

  @@index([userId, status, createdAt])
  @@index([eventId, status])
  @@index([status, expiresAt])
}

model BookingItem {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @db.Uuid
  ticketTierId String?  @db.Uuid
  ticketName   String   @db.VarChar(100)
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  ticketTier TicketTier? @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  tickets    Ticket[]

  @@index([bookingId])
  @@index([ticketTierId])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  bookingId         String          @db.Uuid
  provider          PaymentProvider
  status            PaymentStatus   @default(INITIATED)
  providerReference String?         @unique @db.VarChar(255)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("NPR") @db.VarChar(3)
  metadata          Json?
  initiatedAt       DateTime        @default(now())
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([bookingId, status])
  @@index([provider, status])
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  requestedById     String       @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("NPR") @db.VarChar(3)
  status            RefundStatus @default(REQUESTED)
  providerReference String?      @unique @db.VarChar(255)
  reason            String       @db.VarChar(500)
  failureReason     String?
  metadata          Json?
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@index([status, createdAt])
}

model Ticket {
  id                  String       @id @default(uuid()) @db.Uuid
  bookingId           String       @db.Uuid
  bookingItemId       String?      @db.Uuid
  ticketCode          String       @unique @db.VarChar(40)
  // QR payload is an opaque versioned token only; it must never contain PII.
  // The service validates the submitted token against this SHA-256 hash.
  validationTokenHash String       @unique @db.VarChar(128)
  qrPayload           String       @db.Text
  status              TicketStatus @default(ISSUED)
  issuedAt            DateTime     @default(now())
  checkedInAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItem BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  checkIns    CheckIn[]

  @@index([bookingId, status])
  @@index([status, checkedInAt])
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  eventId   String       @db.Uuid
  rating    Int          @db.SmallInt
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([userId, eventId])
  @@index([eventId, status, createdAt])
}

model FAQ {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(180)
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String?          @db.Uuid
  // targetId is intentionally polymorphic across event/organizer/review/user.
  // The moderation service validates the target type before taking action.
  targetType     ReportTargetType
  targetId       String           @db.Uuid
  reason         String           @db.VarChar(160)
  description    String
  status         ReportStatus     @default(OPEN)
  resolutionNote String?
  resolvedById   String?          @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reporter   User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status])
  @@index([status, createdAt])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, createdAt])
}

model CheckIn {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  checkerId String        @db.Uuid
  result    CheckInResult
  scannedAt DateTime      @default(now())
  notes     String?

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  checker User   @relation("CheckInChecker", fields: [checkerId], references: [id], onDelete: Restrict)

  @@index([ticketId, scannedAt])
  @@index([checkerId, scannedAt])
}
