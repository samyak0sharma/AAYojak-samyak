{
  "name": "aayojak",
  "version": "0.1.0",
  "private": true,
  "description": "Aayojak (आयजक) event discovery, booking, ticketing, and management platform.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aayojak/api --filter @aayojak/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @aayojak/api prisma:generate",
    "db:migrate": "pnpm --filter @aayojak/api prisma:migrate",
    "db:seed": "pnpm --filter @aayojak/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.19.0"
  }
}
